{
  "name": "@poc-intel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts",
    "seed:dev": "tsx --env-file-if-exists=../../.env src/cli/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@poc-intel/shared": "*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "otplib": "^13.5.0",
    "pg-boss": "^12.35.1",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
