# Copy to .env and fill in. Never commit .env.

# Public origin users reach the app at (scheme + host). Used for CSRF origin checks and links.
APP_ORIGIN=https://10.30.11.150

# Caddy: site address and TLS mode.
#   Internal network now: SITE_ADDRESS=https://10.30.11.150   TLS_MODE=internal
# Certificate served to clients that send no SNI (access by IP). Set to the host or IP in SITE_ADDRESS.
DEFAULT_SNI=10.30.11.150
#   With a domain later:  SITE_ADDRESS=poc.example.com        TLS_MODE=admin@example.com   (Let's Encrypt)
SITE_ADDRESS=https://10.30.11.150
TLS_MODE=internal
# Host IP Caddy binds to (Docker-published ports bypass ufw, so bind explicitly).
BIND_IP=10.30.11.150

# PostgreSQL
POSTGRES_USER=pocintel
POSTGRES_DB=pocintel
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://pocintel:change-me@postgres:5432/pocintel

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts TOTP secrets and in-flight Stellar Credentials. Losing it invalidates all MFA enrolments.
ENCRYPTION_KEY=

# First password of the Root Administrator (administrator@stellarcyber.ai), created at the first start.
# It must be changed at the first sign-in; afterwards this value is no longer used.
ROOT_PASSWORD=

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30

# Stellar Cyber instances on private networks are blocked (SSRF guard).
# Comma-separated CIDRs to allow anyway, e.g. an on-prem instance reached over VPN.
STELLAR_ALLOWED_PRIVATE_CIDRS=

# E-mail (prepared, disabled while SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Folder of pg_dump, pg_restore and psql 17 for the Admin backup. Empty in Docker (they are on PATH);
# in local development, e.g. the embedded-postgres binaries.
PG_BIN_DIR=

LOG_LEVEL=info
